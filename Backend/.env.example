DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=
DEMO_PASSWORD=
# 1 enables one-click private demo workspaces, which sign in without a password
DEMO_MODE=0
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=models/gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=models/gemini-3.1-flash-lite
# The deployed frontend's address, comma-separated if more than one. Not needed locally.
CORS_ALLOWED_ORIGINS=
# Leave empty to turn password reset off. Reset links use the first CORS_ALLOWED_ORIGINS address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Leave empty to turn Google sign-in off. Set VITE_GOOGLE_CLIENT_ID in Frontend/.env to the same value.
GOOGLE_CLIENT_ID=
