DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=
DEMO_PASSWORD=
# 1 enables one-click private demo workspaces, which sign in without a password
DEMO_MODE=0
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=models/gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=models/gemini-3.1-flash-lite
# Leave empty to turn Google sign-in off. Set VITE_GOOGLE_CLIENT_ID to the same value for the frontend build.
GOOGLE_CLIENT_ID=
